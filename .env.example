# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง — ห้าม commit .env.local
# ค่าจริงขอจากผู้ดูแลโปรเจกต์ Supabase

# ───────── frontend (ถูก bundle ขึ้นเว็บ เห็นได้จาก browser) ─────────
# ใส่ได้เฉพาะค่าที่เปิดเผยได้ ห้ามใส่ service key ในตัวแปรที่ขึ้นต้นด้วย VITE_
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ───────── scripts นำเข้าข้อมูล (รันบนเครื่อง ไม่ถูก bundle) ─────────
# service role key — ข้ามทุก RLS policy เก็บเป็นความลับเสมอ
SUPABASE_SERVICE_KEY=

# Personal Access Token สำหรับ scripts/run-migration.mjs (Management API)
SUPABASE_ACCESS_TOKEN=

# ───────── Edge Functions ─────────
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# Supabase ใส่ให้อัตโนมัติใน runtime — ไม่ต้องตั้งในไฟล์นี้
