{
  // ให้ TypeScript ของ VS Code (ที่ไม่มี Deno extension) เข้าใจโค้ด Edge Function:
  // - `Deno` global + `npm:` specifier ถูกประกาศใน deno.d.ts / paths ด้านล่าง
  // - ไม่มีผลกับ Deno runtime จริง (Supabase ใช้ deno.json ตอน deploy)
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "npm:@supabase/supabase-js@2": ["../../node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["**/*.ts"]
}
